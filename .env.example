# Pramya environment configuration
#
# Copy this file to .env for local development.
# Never commit .env.

# -------------------------
# Application
# -------------------------

APP_ENV=development
APP_NAME=pramya
APP_VERSION=0.1.0
APP_HOST=127.0.0.1
APP_PORT=8000

# -------------------------
# Database (PostgreSQL + pgvector)
# -------------------------

# Local dev via docker compose ("make up"). SQLite is NOT a production
# substitute — PostgreSQL is authoritative.
DATABASE_URL=postgresql+asyncpg://pramya:pramya@localhost:5432/pramya
DB_ECHO=false

# -------------------------
# DeepSeek (cloud reasoning — escalation-only, never default)
# -------------------------

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60

# -------------------------
# Local AI (oMLX)
# -------------------------

LOCAL_AI_ENABLED=true
LOCAL_AI_RUNTIME=omlx
# Verified against the local runtime: oMLX serves OpenAI-compatible
# endpoints under /v1 on port 8000 (docs/operations/DEPLOYMENT.md).
OMLX_BASE_URL=http://127.0.0.1:8000/v1
OMLX_API_KEY=
# Canonical model IDs registered in the running oMLX (/v1/models).
# pramya-4b = Qwen3.5-4B alias (docs/MODEL_CATALOG.md).
OMLX_CHAT_MODEL=pramya-4b
OMLX_EMBEDDING_MODEL=bge-m3-mlx-4bit
OMLX_RERANK_MODEL=Qwen3-Reranker-0.6B-4bit
# Explicit thinking-off for pramya-4b (never rely on model default).
OMLX_PRAMYA_THINKING_ENABLED=false
OMLX_TIMEOUT_SECONDS=120

# -------------------------
# Voice
# -------------------------

VOICE_RETENTION_DAYS=30
AUDIO_STORAGE_DIR=.runtime/audio

# -------------------------
# Uploads
# -------------------------

UPLOAD_MAX_MB=5
UPLOAD_STORAGE_DIR=.runtime/uploads

# -------------------------
# Observability (Langfuse OSS — self-hosted, MIT-licensed)
#
# Langfuse OSS/self-hosted is the V1 observability/evaluation platform.
# Langfuse Cloud and Enterprise-only features are NOT V1 dependencies.
# LANGFUSE_HOST defaults to a local self-hosted instance; leave unset to
# run without Langfuse (structured logs remain the fallback).
# -------------------------

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# -------------------------
# CORS (comma-separated)
# -------------------------

CORS_ORIGINS=http://localhost:3000

# -------------------------
# Frontend
# -------------------------

VITE_API_URL=http://localhost:8000
