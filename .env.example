# Pramya environment configuration
#
# Copy this file to .env for local development.
# Never commit .env.

# -------------------------
# Application
# -------------------------

APP_ENV=development
APP_NAME=pramya
APP_VERSION=0.1.0
APP_HOST=127.0.0.1
APP_PORT=8000

# -------------------------
# Database (PostgreSQL + pgvector)
# -------------------------

# Local dev via docker compose ("make up"). SQLite is NOT a production
# substitute — PostgreSQL is authoritative.
DATABASE_URL=postgresql+asyncpg://pramya:pramya@localhost:5432/pramya
DB_ECHO=false

# -------------------------
# DeepSeek (cloud reasoning)
# -------------------------

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# -------------------------
# Local AI (oMLX)
# -------------------------

LOCAL_AI_ENABLED=true
LOCAL_AI_RUNTIME=omlx
OMLX_BASE_URL=http://127.0.0.1:7799
OMLX_API_KEY=

# -------------------------
# Voice
# -------------------------

VOICE_RETENTION_DAYS=30
AUDIO_STORAGE_DIR=.runtime/audio

# -------------------------
# Uploads
# -------------------------

UPLOAD_MAX_MB=5
UPLOAD_STORAGE_DIR=.runtime/uploads

# -------------------------
# Observability (Langfuse optional)
# -------------------------

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# -------------------------
# CORS (comma-separated)
# -------------------------

CORS_ORIGINS=http://localhost:3000

# -------------------------
# Frontend
# -------------------------

VITE_API_URL=http://localhost:8000
