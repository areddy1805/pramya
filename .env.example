# Pramya environment configuration
#
# Copy this file to .env for local development.
# Never commit .env.

# -------------------------
# Application
# -------------------------

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# -------------------------
# DeepSeek
# -------------------------

DEEPSEEK_API_KEY=

# -------------------------
# Database
# -------------------------

DATABASE_URL=

# -------------------------
# Local AI
# -------------------------

LOCAL_AI_ENABLED=true
LOCAL_AI_RUNTIME=omlx

# -------------------------
# Frontend
# -------------------------

VITE_API_URL=http://localhost:8000