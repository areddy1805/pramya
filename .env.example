# Pramya environment configuration
#
# Copy this file to .env for local development.
# Never commit .env.

# -------------------------
# Application
# -------------------------

APP_ENV=development
APP_NAME=pramya
APP_VERSION=0.1.0
APP_HOST=127.0.0.1
APP_PORT=8001

# -------------------------
# Database (PostgreSQL + pgvector)
# -------------------------

# Local dev via docker compose ("make up"). SQLite is NOT a production
# substitute — PostgreSQL is authoritative.
DATABASE_URL=postgresql+asyncpg://pramya:pramya@localhost:5432/pramya
DB_ECHO=false

# -------------------------
# DeepSeek (cloud reasoning — escalation-only, never default)
# -------------------------

DEEPSEEK_API_KEY=
# -------------------------
# Provider topology (ADR-023)
# -------------------------

# TEXT -> DeepSeek (all textual/LLM inference)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60

# -------------------------
# Local AI (oMLX) — AUDIO + RETRIEVAL ONLY (no local text LLM)
# -------------------------

LOCAL_AI_ENABLED=true
LOCAL_AI_RUNTIME=omlx
# Verified against the local runtime: oMLX serves OpenAI-compatible
# endpoints under /v1 on port 8000 (docs/operations/DEPLOYMENT.md).
OMLX_BASE_URL=http://127.0.0.1:8000/v1
OMLX_API_KEY=
# Canonical model IDs registered in the running oMLX (/v1/models).
# NOTE: local text-generation models (pramya-4b / qwen2.5-coder-7b) are
# PROHIBITED in the production inference path (ADR-023); OMLX_CHAT_MODEL is
# retained only for provider-construction compatibility and is unused by
# routing.
OMLX_CHAT_MODEL=pramya-4b
OMLX_EMBEDDING_MODEL=bge-m3-mlx-4bit
OMLX_RERANK_MODEL=Qwen3-Reranker-0.6B-4bit
# Explicit thinking-off for any local text model (never relied on).
OMLX_PRAMYA_THINKING_ENABLED=false
OMLX_TIMEOUT_SECONDS=120

# -------------------------
# Voice (oMLX audio; ASR primary + optional, TTS)
# -------------------------

VOICE_PROVIDER=omlx
# Explicit live/offline ASR split (H.4): Parakeet = live, Qwen3-ASR = offline.
VOICE_LIVE_ASR_MODEL=parakeet-tdt-0.6b-v3-int8
VOICE_OFFLINE_ASR_MODEL=Qwen3-ASR-1.7B-4bit
VOICE_TTS_MODEL=Qwen3-TTS-12Hz-0.6B-Base-MLX-4bit
VOICE_SILENCE_SECONDS=1.5
VOICE_SPEECH_RMS=400
VOICE_RETENTION_DAYS=30
AUDIO_STORAGE_DIR=.runtime/audio

# -------------------------
# Uploads
# -------------------------

UPLOAD_MAX_MB=5
UPLOAD_STORAGE_DIR=.runtime/uploads
# Document parsing guards (Phase 2.1): conservative, configurable defaults.
# Page limit bounds PDF parsing; timeout bounds total parse time.
DOCUMENT_MAX_PAGES=50
DOCUMENT_PARSE_TIMEOUT_SECONDS=30

# Knowledge ingestion (Phase 2.2): chunking + embedding batch size.
KNOWLEDGE_CHUNK_SIZE=1200
KNOWLEDGE_CHUNK_OVERLAP=200
KNOWLEDGE_EMBED_BATCH_SIZE=8

# -------------------------
# Observability (Langfuse OSS — self-hosted, MIT-licensed)
#
# Langfuse OSS/self-hosted is the V1 observability platform (ADR-008,
# Phase E — runtime verified). The self-hosted stack runs under the
# `langfuse` docker-compose profile on port 3030:
#
#   docker compose -f docker-compose.yml -f docker-compose.langfuse.yml \
#     --profile langfuse up -d
#
# Create a project API key in the Langfuse UI (http://localhost:3030)
# or via headless init (LANGFUSE_INIT_* in docker-compose.langfuse.yml),
# then set the pair here. 127.0.0.1 (IPv4) is used deliberately: Docker
# publishes IPv4, and `localhost` may resolve to ::1 first.
#
# Leave keys empty to run without Langfuse — the observability facade
# degrades to structured logs and never breaks the interview/voice path.
# -------------------------

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://127.0.0.1:3030

# -------------------------
# CORS (comma-separated)
# -------------------------

CORS_ORIGINS=http://localhost:3000

# -------------------------
# Security (Phase I)
# -------------------------
# API bearer tokens (comma-separated). When non-empty, every /api/v1 request
# except /health + /openapi.json must present `Authorization: Bearer <token>`;
# the voice WebSocket must pass `?token=<token>`. Leave empty in local dev.
#API_TOKENS=
# Per-IP rate limit in requests/minute on /api/v1 (0 = disabled).
RATE_LIMIT_RPM=0
# Emit standard security response headers (X-Content-Type-Options, etc).
SECURITY_HEADERS=true

# -------------------------
# Frontend
# -------------------------

VITE_API_URL=http://localhost:8001
